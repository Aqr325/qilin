# ── Kylin SecOps Agent Environment Configuration ──
# Copy this to .env and fill in your values

# Application
PROJECT_NAME=麒麟OS安全智能运维Agent
VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=kylin_secops
DB_PASSWORD=kylin_secops_2026
DB_NAME=kylin_secops

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=kylin_redis_2026

# JWT (RS256 recommended for production)
JWT_ALGORITHM=RS256
JWT_SECRET_KEY=kylin-secops-jwt-secret-key-change-in-production-2026
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=24

# Celery
CELERY_BROKER_URL=redis://:kylin_redis_2026@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:kylin_redis_2026@localhost:6379/1

# MFA
MFA_ENABLED=false

# AI Service
AI_API_URL=
AI_API_KEY=
AI_MODEL=qwen2.5-7b