# ═══════════════════════════════════════════════════════════════════════
# 麒麟OS 安全智能运维Agent — 环境变量配置
# 复制为 .env 并填入实际值 — 切勿提交含真实密码的 .env 文件
# ═══════════════════════════════════════════════════════════════════════

# ── 应用 ──
DEBUG=False
PROJECT_NAME="麒麟OS安全智能运维Agent"

# ── 数据库 ──
DATABASE_URL="postgresql+asyncpg://kylin_secops:CHANGE_ME@localhost:5432/kylin_secops"
DB_HOST=localhost
DB_PORT=5432
DB_USER=kylin_secops
DB_PASSWORD=CHANGE_ME
DB_NAME=kylin_secops
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME

# ── JWT ──
JWT_SECRET_KEY=CHANGE_ME_USE_RANDOM_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=24

# ── 种子用户密码（首次启动）──
# 方式一：所有种子用户使用同一密码
# KYLIN_SEED_PASSWORD=your_shared_random_password
# 方式二：为特定用户指定独立密码
# KYLIN_SEED_ADMIN_PASSWORD=your_admin_password
# KYLIN_SEED_OPERATOR_PASSWORD=your_operator_password
# KYLIN_SEED_AUDITOR_PASSWORD=your_auditor_password
# KYLIN_SEED_VIEWER_PASSWORD=your_viewer_password
#
# 若不设置以上环境变量，首次启动时每个用户将自动生成 24 位强随机密码
# 并在 DEBUG=True 时输出到日志。

# ── 日志 ──
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── AI ──
AI_API_URL=
AI_API_KEY=
AI_MODEL=qwen2.5-7b

# ── Celery ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1